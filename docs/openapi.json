  "components": {
    "schemas": {
      "AccessTokenResponse": {
        "properties": {
          "accessToken": {
            "type": "string",
            "title": "Accesstoken"
          },
          "accessExpiresIn": {
            "type": "integer",
            "title": "Accessexpiresin"
          }
        },
        "type": "object",
        "required": [
          "accessToken",
          "accessExpiresIn"
        ],
        "title": "AccessTokenResponse"
      },
      "AccountResponse": {
        "properties": {
          "cash": {
            "type": "number",
            "title": "Cash"
          },
          "seed": {
            "type": "number",
            "title": "Seed"
          }
        },
        "type": "object",
        "required": [
          "cash",
          "seed"
        ],
        "title": "AccountResponse",
        "description": "api-spec §4 — 예수금/시드 요약."
      },
      "CandleResponse": {
        "properties": {
          "date": {
            "type": "string",
            "title": "Date"
          },
          "open": {
            "type": "number",
            "title": "Open"
          },
          "high": {
            "type": "number",
            "title": "High"
          },
          "low": {
            "type": "number",
            "title": "Low"
          },
          "close": {
            "type": "number",
            "title": "Close"
          },
          "volume": {
            "type": "integer",
            "title": "Volume"
          }
        },
        "type": "object",
        "required": [
          "date",
          "open",
          "high",
          "low",
          "close",
          "volume"
        ],
        "title": "CandleResponse",
        "description": "api-spec §2 Candle — 일봉 OHLCV."
      },
      "CrossMarkerResponse": {
        "properties": {
          "index": {
            "type": "integer",
            "title": "Index"
          },
          "type": {
            "$ref": "#/components/schemas/CrossType"
          }
        },
        "type": "object",
        "required": [
          "index",
          "type"
        ],
        "title": "CrossMarkerResponse",
        "description": "api-spec §2 CrossMarker — 차트 위 교차 마커(candles 인덱스 기준)."
      },
      "CrossType": {
        "type": "string",
        "enum": [
          "GOLDEN",
          "DEAD"
        ],
        "title": "CrossType"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HoldingResponse": {
        "properties": {
          "stock": {
            "$ref": "#/components/schemas/StockResponse"
          },
          "quantity": {
            "type": "integer",
            "title": "Quantity"
          },
          "avgPrice": {
            "type": "number",
            "title": "Avgprice"
          },
          "currentPrice": {
            "type": "number",
            "title": "Currentprice"
          }
        },
        "type": "object",
        "required": [
          "stock",
          "quantity",
          "avgPrice",
          "currentPrice"
        ],
        "title": "HoldingResponse",
        "description": "api-spec §4 Holding — 서버 집계 보유현황. 평가손익은 클라 파생 계산."
      },
      "IndicatorSetResponse": {
        "properties": {
          "ticker": {
            "type": "string",
            "title": "Ticker"
          },
          "rsi14": {
            "type": "number",
            "title": "Rsi14"
          },
          "candles": {
            "items": {
              "$ref": "#/components/schemas/CandleResponse"
            },
            "type": "array",
            "title": "Candles"
          },
          "rsiSeries": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Rsiseries"
          },
          "ema5": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Ema5"
          },
          "ema20": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Ema20"
          },
          "ema60": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Ema60"
          },
          "ema120": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Ema120"
          },
          "bollingerUpper": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Bollingerupper"
          },
          "bollingerMid": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Bollingermid"
          },
          "bollingerLower": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Bollingerlower"
          },
