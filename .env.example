# PostgreSQL (async). 미설정 시 config.py 기본값 사용(로컬).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sagestock

# 공개 루트 호스트(스킴+호스트, /v1 미포함). OpenAPI servers에 사용.
PUBLIC_BASE_URL=https://api.sagestock.app

# JWT 서명 키 — 운영에선 반드시 교체. HMAC-SHA256 권장 최소 32바이트.
SECRET_KEY=change-me-in-env-with-a-long-random-secret-key

# 토큰 수명 (feature-spec D8)
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# CORS 허용 오리진 (JSON 배열). 예: ["https://app.sagestock.app"]
BACKEND_CORS_ORIGINS=[]

# 한국투자증권(KIS) Open API — 국내 실시간 현재가. 미설정 시 fdr 지연 시세로 폴백.
# KIS Developers(https://apiportal.koreainvestment.com)에서 앱 등록 후 발급.
KIS_APP_KEY=
KIS_APP_SECRET=
# 실전: https://openapi.koreainvestment.com:9443 / 모의: https://openapivts.koreainvestment.com:29443
KIS_BASE_URL=https://openapi.koreainvestment.com:9443
